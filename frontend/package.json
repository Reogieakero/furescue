{
  "name": "furescue-frontend",
  "version": "1.0.0",
  "description": "FurEscue landing page — Tailwind CLI build with shadcn-style UI primitives (no framework).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i ./css/input.css -o ./css/style.css --minify",
    "watch": "tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "dev": "tailwindcss -i ./css/input.css -o ./css/style.css --watch"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
