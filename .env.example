# FURescue (Spot) backend environment configuration.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Database (MySQL 8.0.13+ required for DEFAULT (UUID())) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=furescue
DB_USER=furescue
DB_PASS=change_me

# --- App ---
APP_ENV=development
APP_SECRET=change_me_app_secret
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ALGO=HS256
JWT_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# --- Google Sign-In (server-side token verification) ---
GOOGLE_CLIENT_ID=834001682148-4ihrmh94oeob559qotfqaqbjkidrth3a.apps.googleusercontent.com

# --- IoT device API key for /vitals ingest (X-Device-Key header) ---
DEVICE_API_KEY=change_me_device_key

# --- Report duplicate-detection tuning (open item: default chosen, configurable) ---
DEDUP_RADIUS_METERS=50
DEDUP_TIME_WINDOW_HOURS=24

# --- Mati City bounding box for geovalidation (lat/lng) ---
MATI_LAT_MIN=6.89
MATI_LAT_MAX=7.01
MATI_LNG_MIN=126.13
MATI_LNG_MAX=126.27

# --- CORS allow-list (comma-separated origins, e.g. http://127.0.0.1:8000,https://furescue.example) ---
# Unset/empty falls back to Access-Control-Allow-Origin: * (a warning is logged)
CORS_ALLOWED_ORIGINS=

# --- Dev DB viewer (dbtool/index.php): required ?key= value; empty locks the viewer ---
DEVTOOL_KEY=change_me_devtool_key
